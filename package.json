{
    "name": "ledstrip-mcp",
    "version": "0.5.0",
    "description": "MCP server and CLI for BLE LED strips ELK-BLEDDM / ELK-BLEDOM / ELK-BTC / LEDBLE / MELK (BlueZ, no native builds)",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/svturnring/ledstrip-mcp.git"
    },
    "homepage": "https://github.com/svturnring/ledstrip-mcp#readme",
    "bugs": {
        "url": "https://github.com/svturnring/ledstrip-mcp/issues"
    },
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "ledstrip-mcp": "dist/index.js"
    },
    "main": "dist/index.js",
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "ble",
        "bluetooth",
        "bluez",
        "led-strip",
        "elk-bleddm",
        "elk-bledom",
        "home-assistant"
    ],
    "os": [
        "linux"
    ],
    "scripts": {
        "build": "tsc",
        "prepare": "node scripts/prepare.mjs",
        "typecheck": "tsc --noEmit",
        "start": "node dist/index.js",
        "dev": "tsc --watch",
        "test": "npm run build && node --test tests/*.test.mjs",
        "gen:models": "node scripts/gen-models.mjs && prettier --write src/models.ts src/effects.ts",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\"",
        "check": "npm run typecheck && npm test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "commander": "^15.0.0",
        "node-ble": "^1.13.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}
